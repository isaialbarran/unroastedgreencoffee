#!/bin/sh
# Quita cualquier atribución de IA del mensaje de commit.
# Borra líneas tipo "Co-Authored-By: Claude ..." y "🤖 Generated with [Claude Code]".
# Funciona en macOS (BSD sed) y Linux (GNU sed) gracias a -i.bak.

msg_file="$1"

sed -i.bak -E \
  -e '/^Co-[Aa]uthored-[Bb]y:.*(Claude|Anthropic|noreply@anthropic\.com).*$/d' \
  -e '/Generated with \[?Claude Code\]?/d' \
  -e '/🤖 Generated with/d' \
  "$msg_file"

rm -f "$msg_file.bak"

# Colapsa líneas en blanco finales que pudieran quedar tras el borrado.
# (imprime el archivo sin las líneas vacías del final)
awk 'NF{p=NR} {a[NR]=$0} END{for(i=1;i<=p;i++) print a[i]}' "$msg_file" > "$msg_file.tmp" \
  && mv "$msg_file.tmp" "$msg_file"

exit 0
